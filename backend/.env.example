# Copy to backend/.env and adjust.
#
# Docker Postgres (this repo's docker-compose.yml) maps container 5432 → host 5433:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/zoho_mapping_studio
#
# If you use an existing local Postgres on the default port instead:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/zoho_mapping_studio

REDIS_URL=redis://localhost:6379/0

# Zoho Books (optional for local UI; CoA falls back to demo accounts without token)
ZOHO_API_BASE=https://www.zohoapis.com/books/v3
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_DEFAULT_CONTACT_ID=
ZOHO_CLEARING_ACCOUNT_ID=

# Seed: optional env account IDs for Walmart profile (override PLACEHOLDER)
# ZOHO_WALMART_SALES_ACCOUNT_ID=
